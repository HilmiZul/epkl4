# Dependensi `xlsx` dipasang dari tarball URL (cdn.sheetjs.com), bukan dari registry.
# npm 12+ menetapkan `allow-remote=none` secara default sehingga instalasi gagal
# dengan EALLOWREMOTE. `root` hanya mengizinkan URL yang dideklarasikan di
# package.json proyek ini, sementara URL dari dependensi lain tetap diblokir.
allow-remote=root
